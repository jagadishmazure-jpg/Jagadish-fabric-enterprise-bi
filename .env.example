# Copy to .env for local runs. Nothing here is a secret; Azure auth is Entra ID (az login / OIDC).
# Where the local OneLake stand-in is written (default .onelake/ in the repo).
FABRICBI_LAKE=.onelake
# Subject the MCP server acts for when launched over stdio (see governance/principals.yaml).
FABRICBI_SUBJECT=west.manager@fernhill.example
# Public URL the A2A card advertises (default http://fabric-data-agent.local).
A2A_FABRIC_DATA_AGENT_URL=
# Set by the deploy pipeline once a workspace exists (not used offline).
FABRIC_WORKSPACE_ID=
